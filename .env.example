# ------- Ambiente -------
# "production" ativa validações extras (JWT_SECRET forte, CORS_ORIGIN != "*").
NODE_ENV="development"

# ------- Banco (Supabase) -------
# Supabase -> Project Settings -> Database -> Connection string.
# DATABASE_URL = pooler (Transaction, porta 6543) com ?pgbouncer=true — usado pela app.
# DIRECT_URL   = conexão direta (porta 5432) — usada só pelas migrations do Prisma.
# Fora do Supabase: aponte as duas para o mesmo Postgres.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# ------- API -------
API_PORT=3333
API_HOST=0.0.0.0
# Em producao: gere com `openssl rand -base64 32` (minimo 32 caracteres, sem "troque"/placeholder).
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"
# Em producao, liste os dominios exatos separados por virgula (nunca "*").
CORS_ORIGIN="http://localhost:3000"

# Diretorio onde as evidencias (screenshots, video, dom) sao salvas
STORAGE_DIR="./storage"

# ------- IA -------
# Provider ativo: "claude" | "openai" | "noop"
AI_PROVIDER="claude"
ANTHROPIC_API_KEY=""
# Modelo Claude Fable (mais capaz). Fallback server-side habilitado por padrao.
CLAUDE_MODEL="claude-fable-5"
CLAUDE_FALLBACK_MODEL="claude-opus-4-8"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# ------- Frontend -------
NEXT_PUBLIC_API_URL="http://localhost:3333"
