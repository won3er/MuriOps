{
  "name": "qa-ai",
  "version": "0.1.0",
  "private": true,
  "description": "QA AI - Plataforma SaaS de análise automática de qualidade web com IA",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @qa-ai/api db:generate",
    "db:migrate": "pnpm --filter @qa-ai/api db:migrate",
    "db:deploy": "pnpm --filter @qa-ai/api db:deploy",
    "db:seed": "pnpm --filter @qa-ai/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
