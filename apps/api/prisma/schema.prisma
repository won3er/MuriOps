generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // App usa o pooler (Supabase: porta 6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  // Migrations usam a conexão direta (Supabase: porta 5432). Fora do Supabase,
  // deixe DIRECT_URL igual a DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------- Contas / multi-tenant ----------

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  plan      SubscriptionPlan @default(FREE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Chave de IA própria da organização (opcional), armazenada criptografada
  // (AES-256-GCM). Não há chave compartilhada do servidor como fallback.
  aiProvider          String?
  aiApiKeyEncrypted   String?

  // E-mail (Resend) — usado pelos alertas de Fluxos Críticos (agendamento
  // do Guardian também usava, mas o Guardian foi removido em 09/08/2026;
  // estes 3 campos continuam necessários pro CriticalFlow.sendAlertEmail).
  emailProvider       String?
  emailApiKeyEncrypted String?
  emailFromAddress    String?

  users             User[]
  projects          Project[]
  subscription      Subscription?
  blueprints        Blueprint[]
  remediationPlans  RemediationPlan[]
  upgradePlans      UpgradePlan[]
  criticalFlows     CriticalFlow[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  // Nula para contas criadas via Google — login OAuth não usa senha própria.
  passwordHash   String?
  // Preenchido só para contas criadas/logadas via "Entrar com Google".
  googleId       String?  @unique
  // Registro da versão vigente aceita durante autenticação/cadastro.
  termsAcceptedAt DateTime?
  termsVersion    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Estrutura de assinatura preparada para expansao futura (sem cobranca agora).
model Subscription {
  id             String           @id @default(cuid())
  organizationId String           @unique
  plan           SubscriptionPlan @default(FREE)
  status         String           @default("active")
  // limites por plano (crawler, analises/mes) — aplicados na camada de aplicacao
  maxPagesPerAnalysis Int         @default(50)
  maxAnalysesPerMonth Int         @default(20)
  currentPeriodEnd    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------- Projetos ----------

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  url            String
  organizationId String
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Consentimento pra "Teste Ativo Autorizado" (Análise de Segurança, modo
  // opt-in) — rate-limit/enumeração/payloads limitados contra o próprio
  // site do projeto. Sem isso marcado, a categoria ACTIVE_SECURITY_TEST
  // nunca roda, mesmo se pedida na análise (checado em analysis.service.ts).
  activeTestingConsent         Boolean   @default(false)
  activeTestingConsentAt       DateTime?
  activeTestingConsentByUserId String?

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analyses            Analysis[]
  qualityGates         ProjectQualityGate[]
  adapterConnections   AdapterConnection[]
  projectionTasks      ProjectionTask[]
  criticalFlows        CriticalFlow[]

  @@index([organizationId])
}

// ---------- Analises ----------

enum AnalysisStatus {
  QUEUED
  CRAWLING
  ANALYZING
  AI_REVIEW
  COMPLETED
  FAILED
}

model Analysis {
  id              String         @id @default(cuid())
  projectId       String
  version         Int
  status          AnalysisStatus @default(QUEUED)
  // score agregado + por categoria (JSON: ScoreBreakdown)
  score           Json?
  pagesDiscovered Int            @default(0)
  issueCount      Int            @default(0)
  durationMs      Int?
  aiSummary       String?
  error           String?
  // parametros usados (categorias, maxDepth, maxPages, url override)
  config          Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime       @default(now())

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages    CrawledPage[]
  issues   Issue[]
  evidence Evidence[]

  @@unique([projectId, version])
  @@index([projectId])
}

model CrawledPage {
  id         String  @id @default(cuid())
  analysisId String
  url        String
  title      String?
  depth      Int     @default(0)
  linkedFrom String?
  statusCode Int?

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

enum AnalysisCategory {
  UI
  UX
  PERFORMANCE
  SEO
  ACCESSIBILITY
  SECURITY
  CONSOLE
  NETWORK
  DEEP_SECURITY
  ACTIVE_SECURITY_TEST
  SOURCE_SECURITY_SCAN
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  FIXED
  IGNORED
}

model Issue {
  id               String           @id @default(cuid())
  analysisId       String
  title            String
  description      String
  category         AnalysisCategory
  severity         Severity
  status           IssueStatus      @default(OPEN)
  pageUrl          String?
  selector         String?
  stepsToReproduce String[]
  impact           String?
  suggestion       String?
  raw              String?
  // chave estavel de deteccao para comparar entre versoes
  fingerprint      String
  createdAt        DateTime         @default(now())

  analysis Analysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([analysisId])
  @@index([category])
  @@index([severity])
  @@index([fingerprint])
}

enum EvidenceType {
  SCREENSHOT
  VIDEO
  CONSOLE
  NETWORK
  DOM
}

model Evidence {
  id         String       @id @default(cuid())
  analysisId String
  issueId    String?
  type       EvidenceType
  // caminho relativo dentro do STORAGE_DIR
  path       String
  pageUrl    String?
  viewport   String?
  meta       Json?
  capturedAt DateTime     @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  issue    Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([analysisId])
  @@index([issueId])
}

// ---------- Blueprint (pilar Projetar, REMOVIDO 06/08/2026 — só retenção) ----------
// Model mantido SÓ pra não apagar dados reais: em 07/08/2026, ao validar o
// corte antes do `db push`, `SELECT count(*) FROM "Blueprint"` em produção
// voltou 6 — ou seja, havia uso real que eu não tinha checado (só olhei a
// conta de teste, que tinha zero). Nenhum código novo lê, escreve ou expõe
// isto na UI (rotas, service e páginas já removidos/redirecionados — ver
// CLAUDE.md, sessão "Corte do pilar Projetar/Blueprint"). Se um dia for
// seguro apagar de vez, primeiro exportar os 6 registros (título + result
// em JSON) pra referência, depois `git rm` este bloco e rodar `db push` de
// novo — só então a tabela cai.
model Blueprint {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  createdById    String
  title          String
  mode           String
  provider       String
  status         String   @default("PENDING")
  input          Json
  result         Json?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
}

// ---------- Aplicação (RemediationPlan) ----------
// Transforma os achados de uma Análise (Issues) num plano de ação concreto —
// o que mudar, onde, e como — para o usuário aplicar de verdade no projeto.
// Fase 1: aplicação manual (checklist); a IA não altera o código do usuário,
// só instrui.
// [06/08/2026] Removido o pilar "Projetar"/Blueprint (gerava arquitetura a
// partir de uma descrição solta, sem evidência real como o resto do
// produto — decisão de produto, ver CLAUDE.md). O valor BLUEPRINT do enum
// abaixo continua existindo no Postgres (não dá pra remover valor de enum
// sem recriar o tipo), mas não é mais gravado por nenhum código novo —
// mesmo caso do NUVEMSHOP em AdapterKind.

enum RemediationSourceType {
  ANALYSIS
  BLUEPRINT
  // Exportação por projeto: junta as análises do projeto conforme o escopo
  // (qa | security | full) — o fluxo principal da seção "Aplicação".
  PROJECT
  // Atualizar (UpgradePlan) enviado pra Aplicação — o item já vem pronto do
  // plano de upgrade (sem nova chamada de IA), Aplicação só executa.
  UPGRADE
}

enum RemediationStatus {
  PENDING
  READY
  FAILED
}

model RemediationPlan {
  id             String                @id @default(cuid())
  organizationId String
  // Vínculo ao projeto quando a origem tem um (Análise sempre tem).
  projectId      String?
  createdById    String
  sourceType     RemediationSourceType
  sourceId       String
  // Escopo quando sourceType=PROJECT: "qa" | "security" | "full".
  scope          String?
  title          String
  // provider de IA usado (claude | openai | gemini | noop)
  provider       String
  // Token da ponte universal: permite que a IA do ambiente de dev (Claude
  // Code, Windsurf, Codex...) marque itens como "Feito" via API pública,
  // sem precisar de login. Um token por plano, revogado ao apagar o plano.
  apiToken       String                @unique
  status         RemediationStatus     @default(PENDING)
  // Saída estruturada da IA (RemediationResult).
  result         Json?
  error          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectionTasks ProjectionTask[]

  @@index([organizationId])
  @@index([projectId])
  @@index([sourceType, sourceId])
}

// ---------- Atualizar (UpgradePlan) ----------
// Recebe o package.json de um projeto e devolve um plano de atualização de
// dependências concreto — o que subir, breaking changes esperadas e como
// migrar, item por item. Mesma filosofia da Aplicação: manual ou via ponte
// universal para a IA do ambiente de dev.

enum UpgradeStatus {
  PENDING
  READY
  FAILED
}

model UpgradePlan {
  id             String        @id @default(cuid())
  organizationId String
  // Vínculo opcional a um projeto cadastrado — a atualização também pode ser
  // feita "avulsa", só colando um package.json, sem projeto associado.
  projectId      String?
  createdById    String
  title          String
  // Manifesto original enviado pelo usuário (referência/auditoria). A coluna
  // manteve o nome `packageJsonRaw` por compatibilidade com os planos já
  // gravados, mas desde o suporte multi-linguagem ela guarda qualquer
  // manifesto (requirements.txt, pom.xml, go.mod, .csproj...).
  packageJsonRaw String        @db.Text
  // Ecossistema detectado (npm | pip | maven | go | nuget | legacy ...).
  // Opcional: planos criados antes do suporte multi-linguagem não têm valor
  // e são tratados como "npm" na leitura.
  ecosystem      String?
  // provider de IA usado (claude | openai | gemini | noop)
  provider       String
  // Token da ponte universal — mesma mecânica do RemediationPlan.apiToken.
  apiToken       String        @unique
  status         UpgradeStatus @default(PENDING)
  // Saída estruturada da IA (UpgradeResult).
  result         Json?
  error          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
}

// ---------- Orquestração (REMOVIDA 09/08/2026) ----------
// O ciclo autônomo antigo (OrchestrationRun/OrchestrationEvent, autonomyLevel
// por projeto, quality gates avaliados por iteração) foi substituído por uma
// "Reconciliação" mais simples: sem execuções nem estado próprio, calculada
// on-the-fly comparando a última Analysis do projeto com os RemediationPlans
// gerados a partir dela (quantos itens já foram aplicados vs. quantos faltam).
// Sem clientes reais usando o ciclo antigo, o usuário autorizou apagar
// OrchestrationRun/OrchestrationEvent por completo (mesmo espírito da decisão
// do Guardian) em vez de reter os dados. ProjectQualityGate foi mantido —
// ainda é referenciado pela reconciliação nova como critério de "em dia".

model ProjectQualityGate {
  id       String            @id @default(cuid())
  projectId String
  // null = score geral (Analysis.score.overall); preenchido = uma categoria
  // específica de AnalysisCategory.
  category  AnalysisCategory?
  minScore  Int
  label     String?
  // Proveniência: id do Blueprint de onde este gate foi importado, se houver.
  sourceBlueprintId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum AdapterKind {
  MANUAL_BRIDGE
  MCP
  GITHUB
  // Adicionado em 07/08/2026: mesma lógica do GITHUB (OAuth, apply via
  // Issue/MR), pra cobrir projetos hospedados no GitLab.
  GITLAB
  // Adapters push que aplicam de verdade na plataforma do site (Fase 4).
  // Valores legados, mantidos no schema porque enums PostgreSQL não permitem
  // remoção simples. A migration de remoção apaga todas as conexões desses tipos.
  WORDPRESS
  SHOPIFY
  FTP
}

enum AdapterCapability {
  ANALYZE
  APPLY
  OBSERVE
}

model AdapterConnection {
  id             String              @id @default(cuid())
  projectId      String
  organizationId String
  kind           AdapterKind
  capabilities   AdapterCapability[]
  // "push" | "apply direto pelo adapter" ou "pull" | "ferramenta externa puxa e reporta"
  mode           String
  // Configuração não-secreta (ex: { owner, repo, defaultBranch } do GitHub).
  config         Json?
  // Credencial de terceiro (PAT do GitHub etc.) via secret-box.ts. Nunca usada
  // como chave de busca — segredos genuínos, nunca redisplayed em claro.
  credentialEncrypted   String?
  // Token da ponte (adapters pull: MANUAL_BRIDGE, MCP) — texto plano e único,
  // igual a RemediationPlan.apiToken: não é segredo de terceiro, é gerado por
  // nós e precisa ser buscável por igualdade e reexibível ao dono do projeto.
  bridgeToken    String?             @unique
  // Segredo de verificação de webhook (Fase 2 em diante), via secret-box.ts.
  webhookSecretEncrypted String?
  isActive       Boolean             @default(true)
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
  @@index([projectId])
  @@index([organizationId])
}

// ---------- Projeção (tarefas rastreáveis a partir de um Blueprint) ----------
// Terceira função de Projetar: decompõe o roadmap de um Blueprint em tarefas
// concretas, cada uma virando uma Issue no repositório GitHub conectado do
// projeto (não uma branch/PR direto — decisão de produto: mais simples e
// seguro, sem tocar em código, e a Issue já dá rastreabilidade suficiente).
// Sincroniza por polling (mesmo padrão leve do GuardianSchedule/setInterval
// em main.ts, sem webhook dedicado ainda): quando a Issue fecha no GitHub, a
// tarefa vira DONE aqui automaticamente — é o "Aplicação lê o estado do
// GitHub e marca as tarefas do Projetar como feitas" que o produto promete.

enum ProjectionTaskStatus {
  PENDING
  // Issue criada no GitHub, aguardando o dev fechar/resolver.
  IN_PROGRESS
  DONE
  // Não foi possível criar a Issue (sem conexão GitHub, token inválido etc.).
  FAILED
}

model ProjectionTask {
  id             String               @id @default(cuid())
  remediationPlanId String
  projectId      String
  organizationId String
  title          String
  description    String
  // Ordem de execução sugerida, só cosmético (não bloqueia nada).
  order          Int                  @default(0)
  status         ProjectionTaskStatus @default(PENDING)
  githubIssueNumber Int?
  githubIssueUrl    String?
  // Guarda o motivo quando status = FAILED (ex.: "sem conexão GitHub").
  error          String?
  lastSyncedAt   DateTime?
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  remediationPlan RemediationPlan @relation(fields: [remediationPlanId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([remediationPlanId])
  @@index([projectId])
  @@index([organizationId])
  @@index([status])
}

// [09/08/2026] Guardian (auditoria de documento de negócio) removido — não
// servia à tese central do produto (QA/segurança de projetos de software
// construídos com IA). Sem clientes reais usando, usuário autorizou remoção
// completa incluindo os dados (diferente do precedente do Blueprint, que
// tinha 6 registros reais e foi só esvaziado de código, mantendo o model).

// ---------- Fluxos Críticos (monitoramento sintético) ----------
// Terceiro pilar do produto: enquanto Análise faz um scan pontual sob demanda,
// Fluxos Críticos roda scripts de passos (login, checkout, formulário de lead
// etc.) periodicamente, simulando um usuário real, pra pegar quebras de
// jornada de negócio (não só problemas de código/SEO/acessibilidade) antes
// que o cliente perca vendas por causa delas. Reusa o mesmo lançador de
// Chromium com memória controlada do crawler (crawler.ts).

enum CriticalFlowStepAction {
  NAVIGATE
  CLICK
  FILL
  SELECT
  WAIT_FOR_SELECTOR
  ASSERT_TEXT
  ASSERT_URL
}

enum CriticalFlowFrequency {
  EVERY_15_MIN
  EVERY_HOUR
  DAILY
}

enum FlowRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
}

// Um passo é um objeto simples { action, selector?, value?, expected? } —
// guardado como Json (CriticalFlowStep[]) em vez de tabela própria porque a
// ordem/edição em lote é sempre feita como array inteiro pela UI, igual ao
// padrão já usado em GuardianRuleset.rules.
model CriticalFlow {
  id             String                 @id @default(cuid())
  projectId      String
  organizationId String
  createdById    String
  name           String
  // URL inicial do fluxo — pode divergir da URL cadastrada no projeto (ex.:
  // testar direto a página de checkout).
  startUrl       String
  // CriticalFlowStep[] em ordem de execução.
  steps          Json
  frequency      CriticalFlowFrequency  @default(EVERY_HOUR)
  active         Boolean                @default(true)
  alertEmail     String?
  // Só alerta de novo depois de N falhas seguidas, pra não spammar e-mail
  // por uma instabilidade transiente de rede.
  alertAfterConsecutiveFailures Int     @default(1)
  consecutiveFailures            Int    @default(0)
  lastRunAt      DateTime?
  lastRunStatus  FlowRunStatus?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         FlowRun[]

  @@index([projectId])
  @@index([organizationId])
  @@index([active])
}

model FlowRun {
  id             String         @id @default(cuid())
  criticalFlowId String
  status         FlowRunStatus  @default(PENDING)
  // Índice do passo (em CriticalFlow.steps) onde parou — sucesso (percorreu
  // todos) ou falha (quebrou em algum). Null enquanto RUNNING/PENDING.
  failedStepIndex Int?
  errorMessage    String?
  // Screenshot em base64 do momento da falha (sem storage de objeto externo
  // configurado no projeto ainda — mesmo motivo do texto colado no Guardian,
  // simples o bastante pra v1).
  screenshotBase64 String?        @db.Text
  durationMs      Int?
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?

  criticalFlow CriticalFlow @relation(fields: [criticalFlowId], references: [id], onDelete: Cascade)

  @@index([criticalFlowId])
  @@index([status])
}
