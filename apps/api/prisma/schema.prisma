generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // App usa o pooler (Supabase: porta 6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  // Migrations usam a conexão direta (Supabase: porta 5432). Fora do Supabase,
  // deixe DIRECT_URL igual a DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------- Contas / multi-tenant ----------

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  plan      SubscriptionPlan @default(FREE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Chave de IA própria da organização (opcional). Se ausente, usa a chave
  // padrão do servidor configurada em .env. Armazenada criptografada (AES-256-GCM).
  aiProvider          String?
  aiApiKeyEncrypted   String?

  users             User[]
  projects          Project[]
  subscription      Subscription?
  blueprints        Blueprint[]
  remediationPlans  RemediationPlan[]
  upgradePlans      UpgradePlan[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  // Nula para contas criadas via Google — login OAuth não usa senha própria.
  passwordHash   String?
  // Preenchido só para contas criadas/logadas via "Entrar com Google".
  googleId       String?  @unique
  // Registro da versão vigente aceita durante autenticação/cadastro.
  termsAcceptedAt DateTime?
  termsVersion    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Estrutura de assinatura preparada para expansao futura (sem cobranca agora).
model Subscription {
  id             String           @id @default(cuid())
  organizationId String           @unique
  plan           SubscriptionPlan @default(FREE)
  status         String           @default("active")
  // limites por plano (crawler, analises/mes) — aplicados na camada de aplicacao
  maxPagesPerAnalysis Int         @default(50)
  maxAnalysesPerMonth Int         @default(20)
  currentPeriodEnd    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------- Projetos ----------

enum AutonomyLevel {
  MANUAL
  SUPERVISED
  AUTONOMOUS
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  url            String
  organizationId String
  createdById    String
  autonomyLevel  AutonomyLevel @default(MANUAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analyses            Analysis[]
  orchestrationRuns    OrchestrationRun[]
  qualityGates         ProjectQualityGate[]
  adapterConnections   AdapterConnection[]

  @@index([organizationId])
}

// ---------- Analises ----------

enum AnalysisStatus {
  QUEUED
  CRAWLING
  ANALYZING
  AI_REVIEW
  COMPLETED
  FAILED
}

model Analysis {
  id              String         @id @default(cuid())
  projectId       String
  version         Int
  status          AnalysisStatus @default(QUEUED)
  // score agregado + por categoria (JSON: ScoreBreakdown)
  score           Json?
  pagesDiscovered Int            @default(0)
  issueCount      Int            @default(0)
  durationMs      Int?
  aiSummary       String?
  error           String?
  // parametros usados (categorias, maxDepth, maxPages, url override)
  config          Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime       @default(now())

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages    CrawledPage[]
  issues   Issue[]
  evidence Evidence[]

  @@unique([projectId, version])
  @@index([projectId])
}

model CrawledPage {
  id         String  @id @default(cuid())
  analysisId String
  url        String
  title      String?
  depth      Int     @default(0)
  linkedFrom String?
  statusCode Int?

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

enum AnalysisCategory {
  UI
  UX
  PERFORMANCE
  SEO
  ACCESSIBILITY
  SECURITY
  CONSOLE
  NETWORK
  DEEP_SECURITY
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  FIXED
  IGNORED
}

model Issue {
  id               String           @id @default(cuid())
  analysisId       String
  title            String
  description      String
  category         AnalysisCategory
  severity         Severity
  status           IssueStatus      @default(OPEN)
  pageUrl          String?
  selector         String?
  stepsToReproduce String[]
  impact           String?
  suggestion       String?
  raw              String?
  // chave estavel de deteccao para comparar entre versoes
  fingerprint      String
  createdAt        DateTime         @default(now())

  analysis Analysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([analysisId])
  @@index([category])
  @@index([severity])
  @@index([fingerprint])
}

enum EvidenceType {
  SCREENSHOT
  VIDEO
  CONSOLE
  NETWORK
  DOM
}

model Evidence {
  id         String       @id @default(cuid())
  analysisId String
  issueId    String?
  type       EvidenceType
  // caminho relativo dentro do STORAGE_DIR
  path       String
  pageUrl    String?
  viewport   String?
  meta       Json?
  capturedAt DateTime     @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  issue    Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([analysisId])
  @@index([issueId])
}

// ---------- Blueprint (pilar Projetar) ----------

model Blueprint {
  id             String   @id @default(cuid())
  organizationId String
  // Vínculo opcional a um projeto existente.
  projectId      String?
  createdById    String
  title          String
  // form | canvas | prompt
  mode           String
  // provider de IA usado (claude | openai | gemini | noop)
  provider       String
  // PENDING | READY | FAILED
  status         String   @default("PENDING")
  // Entrada bruta conforme o modo (BlueprintInputPayload).
  input          Json
  // Saída estruturada da IA (BlueprintResult).
  result         Json?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
}

// ---------- Aplicação (RemediationPlan) ----------
// Transforma os achados de uma Análise (Issues) ou de um Blueprint num plano
// de ação concreto — o que mudar, onde, e como — para o usuário aplicar de
// verdade no projeto. Fase 1: aplicação manual (checklist); a IA não altera
// o código do usuário, só instrui.

enum RemediationSourceType {
  ANALYSIS
  BLUEPRINT
  // Exportação por projeto: junta as análises do projeto conforme o escopo
  // (qa | security | full) — o fluxo principal da seção "Aplicação".
  PROJECT
  // Atualizar (UpgradePlan) enviado pra Aplicação — o item já vem pronto do
  // plano de upgrade (sem nova chamada de IA), Aplicação só executa.
  UPGRADE
}

enum RemediationStatus {
  PENDING
  READY
  FAILED
}

model RemediationPlan {
  id             String                @id @default(cuid())
  organizationId String
  // Vínculo ao projeto quando a origem tem um (Análise sempre tem; Blueprint
  // às vezes não está associado a nenhum projeto ainda).
  projectId      String?
  createdById    String
  sourceType     RemediationSourceType
  sourceId       String
  // Escopo quando sourceType=PROJECT: "qa" | "security" | "full".
  scope          String?
  title          String
  // provider de IA usado (claude | openai | gemini | noop)
  provider       String
  // Token da ponte universal: permite que a IA do ambiente de dev (Claude
  // Code, Windsurf, Codex...) marque itens como "Feito" via API pública,
  // sem precisar de login. Um token por plano, revogado ao apagar o plano.
  apiToken       String                @unique
  status         RemediationStatus     @default(PENDING)
  // Saída estruturada da IA (RemediationResult).
  result         Json?
  error          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([sourceType, sourceId])
}

// ---------- Atualizar (UpgradePlan) ----------
// Recebe o package.json de um projeto e devolve um plano de atualização de
// dependências concreto — o que subir, breaking changes esperadas e como
// migrar, item por item. Mesma filosofia da Aplicação: manual ou via ponte
// universal para a IA do ambiente de dev.

enum UpgradeStatus {
  PENDING
  READY
  FAILED
}

model UpgradePlan {
  id             String        @id @default(cuid())
  organizationId String
  // Vínculo opcional a um projeto cadastrado — a atualização também pode ser
  // feita "avulsa", só colando um package.json, sem projeto associado.
  projectId      String?
  createdById    String
  title          String
  // Manifesto original enviado pelo usuário (referência/auditoria). A coluna
  // manteve o nome `packageJsonRaw` por compatibilidade com os planos já
  // gravados, mas desde o suporte multi-linguagem ela guarda qualquer
  // manifesto (requirements.txt, pom.xml, go.mod, .csproj...).
  packageJsonRaw String        @db.Text
  // Ecossistema detectado (npm | pip | maven | go | nuget | legacy ...).
  // Opcional: planos criados antes do suporte multi-linguagem não têm valor
  // e são tratados como "npm" na leitura.
  ecosystem      String?
  // provider de IA usado (claude | openai | gemini | noop)
  provider       String
  // Token da ponte universal — mesma mecânica do RemediationPlan.apiToken.
  apiToken       String        @unique
  status         UpgradeStatus @default(PENDING)
  // Saída estruturada da IA (UpgradeResult).
  result         Json?
  error          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
}

// ---------- Orquestrador + Adapters (núcleo QA-only) ----------
// O orquestrador analisa um projeto, gera um plano, aplica por um adapter
// adequado e reanalisa até bater os quality gates. Toda regra de QA e decisão
// de negócio mora aqui — os adapters ativos (MCP e GitHub) são só
// mecanismos de integração (analyze/apply/observe), nunca donos de lógica.

enum OrchestrationRunStatus {
  QUEUED
  ANALYZING
  EVALUATING_GATES
  PLANNING
  AWAITING_APPLY
  APPLYING
  AWAITING_OBSERVATION
  REANALYZING
  PASSED
  STOPPED
  FAILED
}

enum OrchestrationEventType {
  RUN_STARTED
  ANALYSIS_STARTED
  ANALYSIS_COMPLETED
  GATE_EVALUATED
  PLAN_GENERATED
  APPLY_REQUESTED
  APPLY_APPROVED
  APPLY_COMPLETED
  OBSERVATION_RECEIVED
  ITERATION_ADVANCED
  RUN_PASSED
  RUN_STOPPED
  RUN_FAILED
}

model OrchestrationRun {
  id             String                 @id @default(cuid())
  projectId      String
  organizationId String
  status         OrchestrationRunStatus @default(QUEUED)
  iteration      Int                    @default(1)
  maxIterations  Int                    @default(3)
  // Snapshot do nível de autonomia no início do run (não segue mudanças
  // posteriores em Project.autonomyLevel).
  autonomyLevel  AutonomyLevel
  // Refs soltas (sem @relation), mesmo padrão de RemediationPlan.sourceId —
  // um run atravessa várias Analysis/RemediationPlan ao longo das iterações.
  currentAnalysisId   String?
  currentPlanId       String?
  adapterConnectionId String?
  // { passed, details: [{ category, threshold, actual, passed }] }
  gateResult Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  OrchestrationEvent[]

  @@index([projectId])
  @@index([organizationId])
}

model OrchestrationEvent {
  id        String                 @id @default(cuid())
  runId     String
  type      OrchestrationEventType
  message   String
  data      Json?
  createdAt DateTime               @default(now())

  run OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model ProjectQualityGate {
  id       String            @id @default(cuid())
  projectId String
  // null = score geral (Analysis.score.overall); preenchido = uma categoria
  // específica de AnalysisCategory.
  category  AnalysisCategory?
  minScore  Int
  label     String?
  // Proveniência: id do Blueprint de onde este gate foi importado, se houver.
  sourceBlueprintId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum AdapterKind {
  MANUAL_BRIDGE
  MCP
  GITHUB
  // Adapters push que aplicam de verdade na plataforma do site (Fase 4).
  // Valores legados, mantidos no schema porque enums PostgreSQL não permitem
  // remoção simples. A migration de remoção apaga todas as conexões desses tipos.
  WORDPRESS
  SHOPIFY
  FTP
}

enum AdapterCapability {
  ANALYZE
  APPLY
  OBSERVE
}

model AdapterConnection {
  id             String              @id @default(cuid())
  projectId      String
  organizationId String
  kind           AdapterKind
  capabilities   AdapterCapability[]
  // "push" | "apply direto pelo adapter" ou "pull" | "ferramenta externa puxa e reporta"
  mode           String
  // Configuração não-secreta (ex: { owner, repo, defaultBranch } do GitHub).
  config         Json?
  // Credencial de terceiro (PAT do GitHub etc.) via secret-box.ts. Nunca usada
  // como chave de busca — segredos genuínos, nunca redisplayed em claro.
  credentialEncrypted   String?
  // Token da ponte (adapters pull: MANUAL_BRIDGE, MCP) — texto plano e único,
  // igual a RemediationPlan.apiToken: não é segredo de terceiro, é gerado por
  // nós e precisa ser buscável por igualdade e reexibível ao dono do projeto.
  bridgeToken    String?             @unique
  // Segredo de verificação de webhook (Fase 2 em diante), via secret-box.ts.
  webhookSecretEncrypted String?
  isActive       Boolean             @default(true)
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
  @@index([projectId])
  @@index([organizationId])
}
